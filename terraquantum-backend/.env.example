# ─────────────────────────────────────────────────────────────
# TERRAQUANTUM BACKEND — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env real NUNCA debe commitearse (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Host y puerto donde corre el servidor FastAPI
TERRAQUANTUM_HOST=0.0.0.0
TERRAQUANTUM_PORT=8010

# Origins permitidos por el middleware CORS (separados por coma).
# En desarrollo: solo localhost del frontend Next.js.
# En producción: URL exacta del dominio del frontend.
# NO usar "*" — rompe allow_credentials=True y es un riesgo de seguridad.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Límite de tamaño de archivo CSV subido (en bytes). Default: 10 MB.
CSV_MAX_BYTES=10485760

# ── Autenticación (OBLIGATORIO en producción) ─────────────────────────────────
# TQ_AUTH_ENABLED=true bloquea TODAS las rutas salvo /health y /docs sin X-TQ-API-Key.
# En desarrollo puede dejarse false (default); en producción DEBE ser true.
TQ_AUTH_ENABLED=false

# Master key para crear/revocar API keys via POST/DELETE /api/keys/
# Generar una vez con:
#   python -c "import secrets; print('tqmaster_' + secrets.token_urlsafe(32))"
# Guardar en un gestor de secretos (1Password, AWS Secrets Manager, etc.).
# TQ_MASTER_KEY=tqmaster_REEMPLAZAR_CON_VALOR_REAL

# ── Celery / Redis (workers asíncronos) ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Observabilidad — OpenTelemetry ────────────────────────────────────────────
# OTEL_ENABLED=false (default, sin overhead). true activa tracing.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=terraquantum-backend

# ── Solver ────────────────────────────────────────────────────────────────────
# USE_BOUNDED_SOLVER=true (default). false fuerza LSQR+clip (rollback de emergencia).
USE_BOUNDED_SOLVER=true

# ── Features económicos ───────────────────────────────────────────────────────
# Off por defecto: compliance JORC/NI-43-101. Activar solo con opt-in explícito.
ENABLE_ECONOMIC_FEATURES=false

# ── Google Earth Engine (GEE) ─────────────────────────────────────────────────
# Ruta al archivo JSON de credenciales de la Service Account de GEE.
# Si no se define, se busca automáticamente en la raíz del backend:
#   terraquantum-backend/credenciales_gee.json
# Si el archivo no existe o las credenciales son inválidas, el sistema
# continúa con datos mock (degradación elegante sin romper la app).
# NUNCA incluyas este archivo en el repositorio Git.
# GEE_CREDENTIALS_PATH=/ruta/absoluta/a/credenciales_gee.json
