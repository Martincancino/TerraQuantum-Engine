# ─────────────────────────────────────────────────────────────
# TERRAQUANTUM BACKEND — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env real NUNCA debe commitearse (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Host y puerto donde corre el servidor FastAPI
TERRAQUANTUM_HOST=0.0.0.0
TERRAQUANTUM_PORT=8010

# Origins permitidos por el middleware CORS (separados por coma).
# En desarrollo: solo localhost del frontend Next.js.
# En producción: URL exacta del dominio del frontend.
# NO usar "*" — rompe allow_credentials=True y es un riesgo de seguridad.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Límite de tamaño de archivo CSV subido (en bytes). Default: 10 MB.
CSV_MAX_BYTES=10485760

# ── Google Earth Engine (GEE) ─────────────────────────────────────────────────
# Ruta al archivo JSON de credenciales de la Service Account de GEE.
# Si no se define, se busca automáticamente en la raíz del backend:
#   terraquantum-backend/credenciales_gee.json
# Si el archivo no existe o las credenciales son inválidas, el sistema
# continúa con datos mock (degradación elegante sin romper la app).
# NUNCA incluyas este archivo en el repositorio Git.
# GEE_CREDENTIALS_PATH=/ruta/absoluta/a/credenciales_gee.json
