# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credenciales locales / secretos
credenciales_gee.json
*.service-account.json
*.credentials.json
.env
.env.local

# Runtime outputs
tmp/
public/models/*.glb
public/models/*.tmp
public/models/*.gltf
public/models/*.bin

# Data files generated by backend
data/*.parquet
data/*.csv
data/*.json
data/*.vtr
# SQLite runtime (estado/datos de usuario — F3): la .db ya se ignora; faltaban los sidecars WAL/SHM
data/*.db-shm
data/*.db-wal
# Datasets externos de validación (descargados, reproducibles desde la fuente)
data/external/

# Test outputs (Parquet/Zarr from synthetic_recovery_benchmark, etc.)
tests/inv_*.parquet
tests/inv_*.zarr
tests/*_benchmark_*.parquet
tests/*_benchmark_*.zarr

# Keep folders but ignore generated content
!data/.gitkeep
!tmp/.gitkeep
!public/models/.gitkeep

# Logs
*.log
logs/

# Node accidental files
node_modules/
package-lock.json
# F7 PyInstaller
build/
dist/
*.spec.log
pyinstaller_build.log
spike_run.log
